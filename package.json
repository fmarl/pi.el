{
  "name": "pi.el",
  "version": "0.1.0",
  "description": "Lets Pi and Emacs talk to each other",
  "license": "GPL-3.0-or-later",
  "repository": "github:fmarl/pi.el",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./emacs-bridge/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc && eslint && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test 'emacs-bridge/**/*.test.ts'"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
